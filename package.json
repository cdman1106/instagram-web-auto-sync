{
  "name": "instagram-web-auto-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Instagram to website auto-sync platform on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply instagram-web-auto-sync-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply instagram-web-auto-sync-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
